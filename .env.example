# =============================================================================
# Philippine ID Document Verification API - Environment Configuration
# =============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your actual values below.
# 3. NEVER commit .env to version control.
#
# Services you need:
#   - Supabase  → external (free tier works). Run supabase_schema.sql first.
#   - Redis     → started automatically by docker-compose up
#   - MinIO     → started automatically by docker-compose up

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# Find this in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "URI" tab and copy the full connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# =============================================================================
# REDIS (Celery Broker & Result Backend)
# =============================================================================
# "redis" is the Docker Compose service name — leave this as-is for local dev.
REDIS_URL=redis://redis:6379/0

# =============================================================================
# MINIO (Object Storage for ID Document Images)
# =============================================================================
# "minio" is the Docker Compose service name — leave the endpoint as-is for local dev.
MINIO_ENDPOINT=minio:9000

# Root credentials for the MinIO container. Change in production.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Bucket where uploaded ID document images are stored.
MINIO_BUCKET=id-documents

# false = plain HTTP (local dev). true = HTTPS (production with reverse proxy).
MINIO_SECURE=false

# =============================================================================
# MULTI-TENANCY / API KEY CONFIGURATION
# =============================================================================
# JSON map of API key → system_id. Each integrated platform gets a unique key.
# Supported system IDs and their allowed document types:
#   system1 (HopeCard)  → government_id, organizational_certificate, sec_registration
#   system2 (BayaniHub) → drivers_license, medical_license
#   system3 (Damayan)   → government_id
#
# Generate secure keys in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SYSTEM_MAP={"sk-system1-key-change-me":"system1","sk-system2-key-change-me":"system2","sk-system3-key-change-me":"system3"}

# Comma-separated list of all valid API keys.
# Must exactly match the keys in API_KEY_SYSTEM_MAP above.
ALLOWED_API_KEYS=["sk-system1-key-change-me","sk-system2-key-change-me","sk-system3-key-change-me"]

# =============================================================================
# UPLOAD LIMITS
# =============================================================================
# Maximum allowed image size in megabytes.
MAX_IMAGE_SIZE_MB=10

# =============================================================================
# WEBHOOK / CALLBACK
# =============================================================================
# Timeout in seconds when POSTing review results to the client callback_url.
# Webhooks are sent only after a human reviewer approves or rejects a job.
WEBHOOK_TIMEOUT_SECONDS=30

# =============================================================================
# DEBUG
# =============================================================================
# Set to true to include full exception tracebacks in API error responses.
# NEVER enable in production.
DEBUG=false
