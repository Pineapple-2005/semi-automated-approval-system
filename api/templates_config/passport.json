    "given_names": "(?:Given Names?|Pangalan|GIVEN NAMES?)[:\\s]+([A-Z][A-Za-z\\s\\-]+)",
    "date_of_birth": "(?:Date of Birth|DOB|BIRTH)[:\\s]*(\\d{2}\\s+[A-Z]{3}\\s+\\d{4}|\\d{2}[/\\-]\\d{2}[/\\-]\\d{4})",
    "expiry_date": "(?:Date of Expiry|Expiry|EXPIRY)[:\\s]*(\\d{2}\\s+[A-Z]{3}\\s+\\d{4}|\\d{2}[/\\-]\\d{2}[/\\-]\\d{4})",
    "nationality": "(?:Nationality|NATIONALITY)[:\\s]+(FILIPINO|Filipino)",
    "sex": "\\b(M|F)\\b(?=.*MRZ|.*<)",
    "mrz_line1": "P<PHL([A-Z<]{39})",
    "mrz_line2": "([A-Z0-9<]{44})"
  },
