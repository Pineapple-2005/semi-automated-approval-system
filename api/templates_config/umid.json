{
  "document_type": "umid",
  "display_name": "Unified Multi-Purpose ID (UMID)",
  "issuer": "Social Security System (SSS) / Government Service Insurance System (GSIS)",
  "standard_dimensions_mm": { "width": 85.6, "height": 54.0 },
  "aspect_ratio": 1.5852,
  "required_fields": ["crn", "name", "date_of_birth"],
  "optional_fields": ["address", "blood_type", "sex"],
  "regex_patterns": {
    "crn": "\\b(\\d{2}-\\d{9}-\\d)\\b",
    "name": "(?:Name|PANGALAN)[:\\s]+([A-Z][A-Za-z,\\.\\s\\-]+)",
    "date_of_birth": "(?:Date of Birth|DOB|Petsa ng Kapanganakan)[:\\s]+(\\d{1,2}[/\\-]\\d{1,2}[/\\-]\\d{2,4}|[A-Za-z]+ \\d{1,2},? \\d{4})",
    "blood_type": "(?:Blood Type|BT)[:\\s]+([ABO]{1,2}[+-]?)",
    "sex": "(?:Sex|Kasarian)[:\\s]+(Male|Female|M|F)"
  },
  "ocr_regions": [
    { "name": "photo",       "x_ratio": 0.03, "y_ratio": 0.15, "w_ratio": 0.22, "h_ratio": 0.70 },
    { "name": "crn_area",    "x_ratio": 0.28, "y_ratio": 0.10, "w_ratio": 0.68, "h_ratio": 0.18 },
    { "name": "name_area",   "x_ratio": 0.28, "y_ratio": 0.30, "w_ratio": 0.68, "h_ratio": 0.20 },
    { "name": "dob_area",    "x_ratio": 0.28, "y_ratio": 0.52, "w_ratio": 0.40, "h_ratio": 0.14 },
    { "name": "address_area","x_ratio": 0.28, "y_ratio": 0.68, "w_ratio": 0.68, "h_ratio": 0.20 }
  ],
  "color_hints": {
    "dominant_colors": ["teal", "dark_green", "white", "gold"],
    "background": "teal_gradient",
    "text_color": "white_or_dark"
  },
  "security_features": [
    "Holographic overlay",
    "Laser-engraved photo",
    "UV-reactive ink",
    "Microprinting",
    "Barcode / QR code on back",
    "RFID chip (newer versions)"
  ],
  "notes": "CRN (Common Reference Number) format: XX-XXXXXXXXX-X (2 digits, hyphen, 9 digits, hyphen, 1 check digit). Card is teal/dark-green with gold Philippine eagle motif. Photo is on the left side. Issued since 2011 replacing the old SSS/GSIS/PhilHealth/Pag-IBIG IDs."
}
