{
  "document_type": "sec_registration",
  "display_name": "Philippine SEC Certificate of Registration",
  "issuer": "Securities and Exchange Commission (SEC) of the Philippines",
  "accepted_by_systems": ["system1 (HopeCard)"],
  "supported_entity_types": {
    "CORPORATION":  "Domestic stock / non-stock corporation (prefix CS)",
    "FOUNDATION":   "Non-stock non-profit foundation (prefix FS or CS)",
    "OPC":          "One Person Corporation (prefix OPC)",
    "PARTNERSHIP":  "General or limited partnership (prefix A)",
    "FOREIGN":      "Foreign corporation licensed to do business (prefix FC or NA)"
  },
  "required_fields": ["company_name", "sec_registration_number", "date_of_incorporation"],
  "optional_fields": ["type_of_corporation", "registered_address", "authorized_capital_stock"],
  "regex_patterns": {
    "sec_registration_number": "(?:CS|OPC|A|F|FS|NA|LA|FC)\\d{9,12}",
    "company_name":            "(?:Name of Corporation|Corporate Name|Company Name)[:\\s]+([A-Za-z0-9\\s,\\.\\&\\-']+)",
    "date_of_incorporation":   "(?:Date of Incorporation|Date of Registration)[:\\s]+(\\d{2}[/\\-]\\d{2}[/\\-]\\d{4}|\\w+ \\d{1,2},?\\s*\\d{4})",
    "authorized_capital_stock": "(?:Authorized Capital Stock|Capital Stock)[:\\s]+PHP?\\s*([\\d,\\.]+)"
  },
  "sec_number_formats": {
    "CS":  "CS + 9 digits  (e.g. CS201500001) — domestic corporation",
    "OPC": "OPC + 9 digits (e.g. OPC202100001) — one-person corporation",
    "A":   "A + 9 digits   (e.g. A199900001)  — partnership",
    "FS":  "FS + 9 digits  (e.g. FS200000001) — foreign stock",
    "NA":  "NA + 9 digits  (e.g. NA199800001) — foreign non-stock",
    "FC":  "FC + 9 digits  (e.g. FC200500001) — branch of foreign corp"
  },
  "semantic_validation": {
    "registration_number_pattern": "^(?:CS|OPC|A|F|FS|NA|LA|FC)\\d{9,12}$",
    "flag_if_invalid": "invalid_sec_number_format"
  },
  "color_hints": {
    "dominant_colors": ["white", "black", "sec_maroon"],
    "background": "white_official_letterhead",
    "text_color": "black"
  },
  "security_features": [
    "SEC official dry seal (gold embossed)",
    "Commissioner's signature",
    "SEC letterhead with QR code",
    "Serial number on certificate",
    "Verification available on SEC iView portal"
  ],
  "notes": "The SEC Certificate of Registration is an A4 portrait document. The company name for comparison should be provided in expected_name. For foundations registered with SEC, the type_of_corporation field will be FOUNDATION. Validity is perpetual unless dissolved or revoked — the expiry_check flag is not applicable. The expected_dob field maps to the date_of_incorporation for consistency."
}
