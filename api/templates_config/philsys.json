    "first_name": "(?:First Name|Given Name|PANGALAN)[:\\s]+([A-Z][A-Za-z\\s\\-]+)",
    "middle_name": "(?:Middle Name|GITNANG PANGALAN)[:\\s]+([A-Z][A-Za-z\\s\\-]+)",
    "name": "([A-Z][A-Z\\s,\\.\\-]+(?:,\\s*[A-Z][A-Z\\s\\.\\-]+){1,2})",
    "date_of_birth": "(?:Date of Birth|Petsa ng Kapanganakan|DOB)[:\\s]+(\\d{2}[/\\-]\\d{2}[/\\-]\\d{4})",
    "sex": "(?:Sex|Kasarian)[:\\s]+(MALE|FEMALE|Male|Female)",
    "blood_type": "(?:Blood Type|Grupo ng Dugo)[:\\s]+([ABO]{1,2}[+-]?)",
    "address": "(?:Address|Tirahan)[:\\s]+(.+?)(?=\\n(?:[A-Z]|$)|$)"
  },
